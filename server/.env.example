# PRODUCTION NOTE: this .env file approach is for local development only.
# Never commit a real .env, and don't treat copying this file around by
# hand as your production secret-management strategy — use your hosting
# platform's secret manager (e.g. a cloud provider's secrets service, or
# your PaaS's built-in env/secret store), inject secrets at deploy time,
# and rotate credentials periodically (especially after any suspected
# exposure). See THREAT_MODEL.md for what each of these secrets protects.

PORT=4000
NODE_ENV=development
API_VERSION=v1
CLIENT_ORIGIN=http://localhost:5173

# Leave MONGODB_URI empty in development to auto-start an in-memory MongoDB.
MONGODB_URI=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

PAYMENT_PROVIDER_MODE=mock
PAYMENT_KEY=
PAYMENT_SECRET=

SHIPPING_PROVIDER_MODE=mock
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_API_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_WEBHOOK_SECRET=

STORAGE_PROVIDER_MODE=mock
PUBLIC_SERVER_URL=http://localhost:4000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

REDIS_ENABLED=false
REDIS_URL=

EMAIL_PROVIDER_MODE=mock
EMAIL_API_KEY=
EMAIL_FROM=Homemade Marketplace <no-reply@example.com>

PAYMENT_TIMEOUT_MINUTES=20
DEFAULT_COMMISSION_RATE_BPS=1500
